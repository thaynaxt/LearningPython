        print("-" * 70)
        print("\nEscolha uma das opções:")
        print("1. Calcular IMC")
        print("2. Sugestões de alimentação com base no seu objetivo")
        print("3. Dicas acessíveis para um estilo de vida saudável")
        print("4. Sair")

        opcao = input("Digite o número da opção escolhida:")
        print("-" * 70)

        if opcao == "1":
            calcular_imc()
        elif opcao == "2":
            sugestao_alimentacao()
        elif opcao == "3":
            dicas_estilo_vida()
        elif opcao == "4":
